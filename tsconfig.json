{
  "compilerOptions": {
    "target": "ES2020",
    "module": "preserve",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./static/js",
    "rootDir": "./frontend/ts",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false
  },
  "include": ["frontend/ts/types.ts", "frontend/ts/storage.ts", "frontend/ts/login.ts", "frontend/ts/camera-monitor.ts", "frontend/ts/live-feed.ts"]
}
